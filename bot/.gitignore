@'
# Discord bot secrets
.env
.env.*
!.env.example
*.token
*.pem

# Python virtual environments
.venv/
venv/
env/

# Local database and runtime data
data/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Python temporary files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build files
build/
dist/
*.egg-info/

# Editor and system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
logs/
*.tmp
*.bak
'@ | Set-Content -Path .gitignore